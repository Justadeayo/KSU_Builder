From 19353b30d10ba9de73d4d867de4ce8be9f410f11 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Thu, 11 Jun 2026 07:28:23 +0800
Subject: [PATCH] kernel: app_profile: add 32-bit KSU_NO_NEW_PRIVS tif flag

---
 kernel/policy/app_profile.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/kernel/policy/app_profile.h b/kernel/policy/app_profile.h
index d41d1a3e..8723f868 100644
--- a/kernel/policy/app_profile.h
+++ b/kernel/policy/app_profile.h
@@ -1,7 +1,17 @@
 #ifndef __KSU_H_APP_PROFILE
 #define __KSU_H_APP_PROFILE
 
+#if defined(CONFIG_64BIT)
 #define TIF_KSU_DISABLE_ESCAPE_WITH_ROOT 63
+#define TIF_KSU_RESERVED_62 62
+#define TIF_KSU_UNMOUNTABLE 61
+#define TIF_KSU_MANAGED	60
+#else
+#define TIF_KSU_DISABLE_ESCAPE_WITH_ROOT 31
+#define TIF_KSU_RESERVED_30 30
+#define TIF_KSU_UNMOUNTABLE 29
+#define TIF_KSU_MANAGED	28
+#endif
 
 // Escalate current process to root with the appropriate profile
 int escape_with_root_profile(void);
-- 
2.43.0

