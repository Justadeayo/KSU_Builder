-            }
             if (state.requiresNewKernel) {
                 WarningCard(
                     stringResource(
@@ -224,7 +222,7 @@ private fun StatusCard(
         }
         val workingMode = if (ksuActive) {
             when (state.lkmMode) {
-                null -> ""
+                null -> if (Build.SUPPORTED_64_BIT_ABIS.isEmpty()) "32-BIT" else "LEGACY"
                 true -> "LKM"
                 else -> "GKI"
             }
