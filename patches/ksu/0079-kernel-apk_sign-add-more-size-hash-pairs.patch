From a19331a182aa9e0382d08ee924bc2524d62f51f7 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Tue, 6 Jan 2026 00:11:53 +0800
Subject: [PATCH] kernel: apk_sign: add more size/hash pairs

---
 kernel/manager/apk_sign.c       | 18 +++++++++++++++++-
 kernel/manager/throne_tracker.c | 17 +++++++++++++++--
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/kernel/manager/apk_sign.c b/kernel/manager/apk_sign.c
index c6269ff4..55e79b15 100644
--- a/kernel/manager/apk_sign.c
+++ b/kernel/manager/apk_sign.c
@@ -319,5 +319,21 @@ int get_pkg_from_apk_dir_path(char *pkg, const char *path)
 
 bool is_manager_apk(char *path)
 {
-	return check_v2_signature(path, EXPECTED_SIZE, EXPECTED_HASH);
+	// dummy.keystore
+	if (check_v2_signature(path, 0x363, "4359c171f32543394cbc23ef908c4bb94cad7c8087002ba164c8230948c21549"))
+		return true;
+
+	// kernelsu official
+	if (check_v2_signature(path, EXPECTED_SIZE, EXPECTED_HASH))
+		return true;
+
+	// KOWX712/KernelSU
+	if (check_v2_signature(path, 0x375, "484fcba6e6c43b1fb09700633bf2fb4758f13cb0b2f4457b80d075084b26c588"))
+		return true;
+
+	// midori01/KernelSU
+	if (check_v2_signature(path, 0x0368, "b9ee6759de4794f954883458b722b97ae6527cb7709a051db9a2348c0eea1e42"))
+		return true;
+
+	return false;
 }
diff --git a/kernel/manager/throne_tracker.c b/kernel/manager/throne_tracker.c
index b116c29d..38970c04 100644
--- a/kernel/manager/throne_tracker.c
+++ b/kernel/manager/throne_tracker.c
@@ -6,6 +6,16 @@ uid_t ksu_manager_appid = KSU_INVALID_APPID;
 
 static char cached_manager_apk_path[DATA_PATH_LEN];
 
+// extendable manager support
+#define extra_manager_apk(tgt, name) ({			\
+	static_assert(__builtin_constant_p(name));	\
+	static_assert(DATA_PATH_LEN > sizeof(name));	\
+	!strncmp(tgt, name, sizeof(name));		\
+})
+#define is_kowsu_apk(tgt) extra_manager_apk(tgt, "com.kowx712.supermanager")
+#define is_midorisu_apk(tgt) extra_manager_apk(tgt, "com.midori.supermanager")
+#define test_extra_pkgs(tgt) (is_kowsu_apk(tgt) || is_midorisu_apk(tgt))
+
 #define SYSTEM_PACKAGES_LIST_PATH "/data/system/packages.list"
 
 struct uid_data {
@@ -20,7 +30,7 @@ static void crown_manager(const char *apk, struct list_head *uid_data)
 	struct uid_data *np;
 
 	list_for_each_entry (np, list, list) {
-		if (strncmp(np->package, KSU_PACKAGE_NAME, KSU_MAX_PACKAGE_NAME) == 0) {
+		if (test_extra_pkgs(np->package) || strncmp(np->package, KSU_PACKAGE_NAME, KSU_MAX_PACKAGE_NAME) == 0) {
 			pr_info("Crowning manager: uid=%d\n", np->uid);
 			ksu_set_manager_appid(np->uid);
 			break;
@@ -62,6 +72,9 @@ static bool maybe_manager_apk_dir(const char *path)
 		return false;
 	}
 
+	if (test_extra_pkgs(pkg))
+		return true;
+
 	// pkg is `<real package>`
 	return strncmp(pkg, KSU_PACKAGE_NAME, sizeof(KSU_PACKAGE_NAME)) == 0;
 }
@@ -296,7 +309,7 @@ static void throne_tracker_fn(bool prune_only)
 	uid_t manager_package_uid = KSU_INVALID_APPID;
 	bool need_rescan = false;
 	list_for_each_entry (np, &uid_list, list) {
-		if (strcmp(np->package, KSU_PACKAGE_NAME) == 0) {
+		if (test_extra_pkgs(np->package) || strcmp(np->package, KSU_PACKAGE_NAME) == 0) {
 			manager_package_uid = np->uid;
 			break;
 		}
-- 
2.43.0

