From bfd0a7605c25c9a80daa76ea1065272507d8314a Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Thu, 24 Sep 2026 11:21:43 +0800
Subject: [PATCH] kernel: feature: umount: adjust for downstream

---
 kernel/feature/kernel_umount.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index e883b95f..3297df60 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -21,6 +21,7 @@ static const struct ksu_feature_handler kernel_umount_handler = {
 	.set_handler = kernel_umount_feature_set,
 };
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
 extern int path_umount(struct path *path, int flags);
 
 static inline void ksu_umount_mnt(const char *mnt, struct path *path, int flags)
@@ -29,6 +30,28 @@ static inline void ksu_umount_mnt(const char *mnt, struct path *path, int flags)
 	if (err)
 		pr_info("umount %s failed: %d\n", mnt, err);
 }
+#else /* we play 'guess if backported' */
+static __nocfi inline void ksu_umount_mnt(const char *mnt, struct path *path, int flags)
+{
+	int err;
+#ifndef MODULE
+	extern int path_umount(struct path *path, int flags) __weak;
+	if (path_umount) {
+		err = path_umount(path, flags);
+		goto out;
+	}
+#endif
+	mm_segment_t old_fs = get_fs();
+	set_fs(KERNEL_DS);
+	err = (int)ksyscall(umount, (char __user *)mnt, flags);
+	set_fs(old_fs);
+	path_put(path);  // release caller's ref
+	goto out;
+out:
+	if (err)
+		pr_info("umount %s failed: %d\n", mnt, err);
+}
+#endif
 
 static inline void try_umount(const char *mnt, int flags)
 {
@@ -84,6 +107,9 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 	// umount the target mnt
 	pr_info("handle umount for uid: %d, pid: %d\n", new_uid, current->pid);
 
+	// hostsredirect and getpriority filter tracks this flag
+	set_thread_flag(TIF_KSU_UNMOUNTABLE);
+
 	const struct cred *saved = override_creds(ksu_cred);
 
 	struct mount_entry *entry;
-- 
2.43.0

