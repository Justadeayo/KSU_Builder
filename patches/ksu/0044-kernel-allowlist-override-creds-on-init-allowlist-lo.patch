From f5c79fe9069835ff430ef82d3ac01f9ea16045b0 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Sat, 3 Oct 2026 11:54:51 +0800
Subject: [PATCH] kernel: allowlist: override creds on init allowlist load

---
 kernel/policy/allowlist.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/kernel/policy/allowlist.c b/kernel/policy/allowlist.c
index c17f28de..8030971a 100644
--- a/kernel/policy/allowlist.c
+++ b/kernel/policy/allowlist.c
@@ -448,7 +448,9 @@ void ksu_load_allow_list()
 	size_t app_profile_size;
 
 	// load allowlist now!
+	const struct cred *saved = override_creds(ksu_cred);
 	fp = filp_open(KERNEL_SU_ALLOWLIST, O_RDONLY, 0);
+	revert_creds(saved);
 	if (IS_ERR(fp)) {
 		pr_err("load_allow_list open file failed: %ld\n", PTR_ERR(fp));
 		return;
-- 
2.43.0

