+#define __runner_COMPILER __runner_CLANG " on zig " ZIG_VERSION
+
+#define __runner_BUILD_INFO "KernelSU preinit ELF running on " __runner_ARCH "! / buildinfo: " __runner_COMPILER " stdc: " __runner_STDC
+
