From 759a51dfaac6a2b005b30352e8923e460a6f9d68 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Mon, 19 Oct 2026 17:46:17 +0800
Subject: [PATCH] kernel: preinit/runner: remove nolibc dependence

---
 kernel/preinit/runner/Makefile                |  36 +
 kernel/preinit/runner/README                  |   7 +
 kernel/preinit/runner/picoprintf/LICENSE      |  21 +
 kernel/preinit/runner/picoprintf/README       |   2 +
 kernel/preinit/runner/picoprintf/picobool.h   |  20 +
 kernel/preinit/runner/picoprintf/picoprintf.c | 400 ++++++++
 kernel/preinit/runner/picoprintf/picoprintf.h |  44 +
 kernel/preinit/runner/runner.c                |  14 +-
 kernel/preinit/runner/runner_oot.h            | 316 ++++++
 kernel/preinit/runner/runner_xxd.h            | 956 ++++++++++++++++++
 kernel/preinit/runner/small_rt.h              | 183 ++++
 11 files changed, 1994 insertions(+), 5 deletions(-)
 create mode 100644 kernel/preinit/runner/Makefile
 create mode 100644 kernel/preinit/runner/README
 create mode 100644 kernel/preinit/runner/picoprintf/LICENSE
 create mode 100644 kernel/preinit/runner/picoprintf/README
 create mode 100644 kernel/preinit/runner/picoprintf/picobool.h
 create mode 100644 kernel/preinit/runner/picoprintf/picoprintf.c
 create mode 100644 kernel/preinit/runner/picoprintf/picoprintf.h
 create mode 100644 kernel/preinit/runner/runner_oot.h
 create mode 100644 kernel/preinit/runner/runner_xxd.h
 create mode 100644 kernel/preinit/runner/small_rt.h

diff --git a/kernel/preinit/runner/Makefile b/kernel/preinit/runner/Makefile
new file mode 100644
index 00000000..7f50609e
--- /dev/null
+++ b/kernel/preinit/runner/Makefile
@@ -0,0 +1,36 @@
+CC = zig cc
+SRC = runner.c
+TARGET = runner_binary
+DUMP = runner_xxd.h
+
+ZIG_VER := $(shell zig version)
+
+CFLAGS += -target aarch64-linux -std=gnu2y
+CFLAGS += -Oz -flto -s -static
+CFLAGS += -fno-unwind-tables -fmerge-all-constants
+CFLAGS +=  -fno-builtin-memcpy
+CFLAGS += -Wl,--entry=__start
+CFLAGS += -s -Wl,--gc-sections,-z,norelro
+CFLAGS += -Wno-int-conversion -Wno-unknown-attributes -Wno-macro-redefined
+
+CFLAGS += -DZIG_VERSION=\"$(ZIG_VER)\"
+
+all: $(TARGET) $(DUMP)
+
+$(TARGET): $(SRC)
+	$(CC) $(CFLAGS) $(SRC) -o $@
+	@if command -v sstrip >/dev/null 2>&1; then sstrip $(TARGET); fi
+#	@if command -v upx >/dev/null 2>&1; then upx --ultra-brute $(TARGET); fi
+
+$(DUMP): $(TARGET)
+# maybe in 10 years C23 #embed will be the norm
+# for now not a big deal for a < 15kb binary.
+	xxd -i $(TARGET) > $@
+	tail -n1 $@
+	rm -f $(TARGET)
+
+clean:
+	rm -f $(TARGET) > /dev/null 2>&1
+	rm -f $(DUMP) > /dev/null 2>&1
+
+.PHONY: all clean
diff --git a/kernel/preinit/runner/README b/kernel/preinit/runner/README
