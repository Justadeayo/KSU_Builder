From 18e976483463e101b0f18cb3f6b16d869b4fa4c8 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Fri, 13 Jun 2025 18:53:15 +0800
Subject: [PATCH] kernel: ksud: handle conditional read_iter requirement for < 3.16

---
 kernel/Makefile                   | 6 ++++++
 kernel/runtime/ksud_integration.c | 4 ++++
 2 files changed, 10 insertions(+)

diff --git a/kernel/Makefile b/kernel/Makefile
index 5c5291cb..49434d0c 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -62,6 +62,12 @@ ifeq ($(shell grep "long do_faccessat" $(srctree)/fs/open.c 2>/dev/null | grep -
 CFLAGS_ksu.o += -DKSU_HAS_FACCESSAT2
 endif
 
+# UL, look for read_iter on f_op struct
+ifeq ($(shell grep -q "read_iter" $(srctree)/include/linux/fs.h 2>/dev/null; echo $$?),0)
+$(info -- KernelSU/compat: f_op->read_iter found!)
+CFLAGS_ksu.o += -DKSU_HAS_FOP_READ_ITER
+endif
+
 CFLAGS_ksu.o += $(call cc-option, -Wno-declaration-after-statement)
 CFLAGS_ksu.o += $(call cc-option, -Wno-implicit-function-declaration)
 CFLAGS_ksu.o += $(call cc-option, -Wno-missing-prototypes)
diff --git a/kernel/runtime/ksud_integration.c b/kernel/runtime/ksud_integration.c
index 056c8417..3ce7dfbe 100644
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -232,6 +232,7 @@ append_module_rc:
 	return ret;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 16, 0) || defined(KSU_HAS_FOP_READ_ITER)
 static ssize_t read_iter_proxy(struct kiocb *iocb, struct iov_iter *to)
 {
 	ssize_t ret = 0;
@@ -283,6 +284,7 @@ append_module_rc:
 	}
 	return ret;
 }
+#endif
 
 static bool is_init_rc(struct file *fp)
 {
@@ -352,10 +354,12 @@ static noinline void ksu_install_rc_hook(struct file *file)
 	if (orig_read) {
 		fops_proxy.read = read_proxy;
 	}
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 16, 0) || defined(KSU_HAS_FOP_READ_ITER)
 	orig_read_iter = file->f_op->read_iter;
 	if (orig_read_iter) {
 		fops_proxy.read_iter = read_iter_proxy;
 	}
+#endif
 	// replace the file_operations
 	file->f_op = &fops_proxy;
 
-- 
2.43.0

