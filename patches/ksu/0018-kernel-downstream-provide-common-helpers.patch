diff --git a/kernel/downstream/arm64_branch_patch.h b/kernel/downstream/arm64_branch_patch.h
new file mode 100644
index 00000000..2db69dff
--- /dev/null
+++ b/kernel/downstream/arm64_branch_patch.h
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 \xx
+ *
+ * This file is a downstream extension and NOT affiliated, endorsed by,
+ * or maintained by the official KernelSU developers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ */
+
+#ifndef __H_ARM64_BRANCH_PATCH
+#define __H_ARM64_BRANCH_PATCH
+
+#include <linux/version.h>
+#include <linux/uaccess.h>
+#include <asm/insn.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0)
+#include <asm/text-patching.h>
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 14, 0)
+#include <asm/patching.h>
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 2, 0)
+__weak s32 aarch64_get_branch_offset(u32 insn)
+{
+	// 26-bit signed relative jump offset
+	// FC, D, E, F, so 3
+	s32 imm26 = insn & 0x03FFFFFF;
+
+	// in case of backward jumps
+	if (imm26 & 0x02000000)
+		imm26 |= 0xFC000000;
+
+	// 4-byte word count to byte delta
+	return imm26 * 4;
+}
+#endif
+
+/**
+ * arm64_branch_patch(): hunt and patch all b or bl insn found within target
+ *
+ * @target_callsite: callsite on where to start scanning for (ptr / fn_ptr)
+ * @target_width: how far to scan for (bytes / ptrdiff)
+ * @symbol_addr: symbol being called to look for at the site (fn_ptr)
+ * @hook_addr: symbol to redirect "b symbol_addr" to (fn_ptr)
+ * @type: branch type to look for. 1: b, 2: bl, 3: b or bl
+ *
+ * CONTEXT:
+ * - do NOT call inside atomic context! (aarch64_insn_patch_text calls stop_machine)
+ * - safe to run early or within kernel threads.
+ *
+ * NOTES:
+ * - both symbol_addr and hook_addr must be inside +/-128MB ptrdiff to callsite! else ret -ERANGE
+ * - if target bl not found within target_width, ret -ENOENT
+ * - returns 0 on success.
+ * - preserves instruction type (e.g., 'BL' becomes a 'BL' to the hook, and 'B' becomes a 'B' to the hook).
+ * 
+ */
+#define BRANCH_TYPE_B		1
+#define BRANCH_TYPE_BL		2
+#define BRANCH_TYPE_B_OR_BL	3
+nodiscard static noinline int arm64_branch_patch(uintptr_t target_callsite, ptrdiff_t target_width, uintptr_t symbol_addr, uintptr_t hook_addr, uint8_t type)
+{
+	if (!target_callsite || !symbol_addr) {
+		pr_info("%s: no callsite or symbol addr specified!\n", __func__);
+		return -EINVAL;
+	}
+
+	might_sleep();
+
+	constexpr ptrdiff_t bl_max_delta = (1L << 25) * sizeof(uint32_t); // 26 bits signed * insn size
+	uintptr_t start_addr = (uintptr_t)target_callsite;
+	uintptr_t end_addr = start_addr + target_width;
+
+	ptrdiff_t hook_to_start = (ptrdiff_t)hook_addr - (ptrdiff_t)start_addr;
+	ptrdiff_t hook_to_end = (ptrdiff_t)hook_addr - (ptrdiff_t)end_addr;
+	if (__builtin_labs(hook_to_start) >= bl_max_delta || __builtin_labs(hook_to_end) >= bl_max_delta) {
+		pr_info("%s: callsite: 0x%lx ~ 0x%lx hook: 0x%lx out of range!\n", __func__, start_addr, end_addr, hook_addr);
+		return -ERANGE;
+	}
+//	pr_info("%s: scan window start: 0x%lx end: 0x%lx in range to hook: 0x%lx deltas: %ld / %ld \n", __func__, start_addr, end_addr, hook_addr, hook_to_start, hook_to_end);
+
+	uintptr_t curr_addr = start_addr;
+	uint32_t raw_instruction; // arm64 wordsize
+	unsigned int patched = 0;
+
+start_scan:
+	if (curr_addr >= end_addr)
+		goto bail;
+
+	if (!!copy_from_kernel_nofault(&raw_instruction, (void *)curr_addr, sizeof(uint32_t)))
+		goto step_up;
+
+	// aarch64_insn_is_##abbr, arch/arm64/include/asm/insn.h
+	switch (type) {
+	case BRANCH_TYPE_BL:
+		if (!aarch64_insn_is_bl(raw_instruction))
+			goto step_up;
+		break;
+	case BRANCH_TYPE_B:
+		if (!aarch64_insn_is_b(raw_instruction))
+			goto step_up;
+		break;
+	case BRANCH_TYPE_B_OR_BL:
+		if (!aarch64_insn_is_bl(raw_instruction) && !aarch64_insn_is_b(raw_instruction))
+			goto step_up;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	// signed
+	long offset = aarch64_get_branch_offset(raw_instruction);
+	uintptr_t calculated_destination = curr_addr + offset;
+
+	if (calculated_destination != symbol_addr)
+		goto step_up;
+
+	pr_info("%s: found call site at 0x%lx w/ .inst 0x%x \n", __func__, curr_addr, raw_instruction);
+
+	ptrdiff_t delta = hook_addr - curr_addr;
+	if (__builtin_labs(delta) >= bl_max_delta) {
+		__builtin_unreachable(); // see range check above
+		pr_info("%s: callsite 0x%lx to hook 0x%lx out of range! (delta: %ld bytes)\n",  __func__, curr_addr, hook_addr, delta);
+		return -ERANGE;
+	}
+
+	pr_info("%s: callsite: 0x%lx hook: 0x%lx (delta: %ld bytes)\n",  __func__, curr_addr, hook_addr, delta);
+
+	uint32_t insn;
+	if (aarch64_insn_is_bl(raw_instruction))
+		insn = aarch64_insn_gen_branch_imm(curr_addr, hook_addr, AARCH64_INSN_BRANCH_LINK);
+	else
+		insn = aarch64_insn_gen_branch_imm(curr_addr, hook_addr, AARCH64_INSN_BRANCH_NOLINK);
+
+	void *arr_addr[] = { (void*)curr_addr };
+	uint32_t arr_insn[] = { insn };
+
+	int res = aarch64_insn_patch_text(arr_addr, arr_insn, 1);
+	pr_info("%s: callsite: 0x%lx patch result: %d\n", __func__, curr_addr, res);
+	if (!res)
+		patched++;
+
+step_up:
+	curr_addr = curr_addr + sizeof(uint32_t);
+	goto start_scan;
+
+bail:
+	if (!patched) {
+		pr_info("%s: callsite instruction not found!\n", __func__);
+		return -ENOENT;
+	}
+
+	if (patched > 1)
+		pr_info("%s: patch count: %d\n", __func__, patched);
+	return 0;
+}
+
+#define arm64_b_patch(tgt, width, symaddr, hookaddr)		arm64_branch_patch(tgt, width, symaddr, hookaddr, BRANCH_TYPE_B)
+#define arm64_bl_patch(tgt, width, symaddr, hookaddr)		arm64_branch_patch(tgt, width, symaddr, hookaddr, BRANCH_TYPE_BL)
+#define arm64_b_or_bl_patch(tgt, width, symaddr, hookaddr)	arm64_branch_patch(tgt, width, symaddr, hookaddr, BRANCH_TYPE_B_OR_BL)
+
+#endif // __H_ARM64_BRANCH_PATCH
diff --git a/kernel/downstream/arm64_syscall_table_mirror.h b/kernel/downstream/arm64_syscall_table_mirror.h
new file mode 100644
index 00000000..0614107b
--- /dev/null
+++ b/kernel/downstream/arm64_syscall_table_mirror.h
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 \xx
+ *
+ * This file is a downstream extension and NOT affiliated, endorsed by,
+ * or maintained by the official KernelSU developers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ */
+
+/**
+ *  syscall_table_mirror - lets own the full table ourselves.
+ *
+ *  Due to some kernel protection bullshit, vmapping as writable is no go.
+ *  either by straight up blocking EL2 MMU access or due to integrity checks. (e.g. checksums against the table)
+ *
+ *  This method explores replacing the page adrp loads around ~el0_svc.
+ *
+ *  * 4.14 and older (pre syscall wrapper, aligned to 4096, natural adrp alignment)
+ *  ffffff8010083f80 <el0_svc>:
+ *  ffffff8010083f80: b000f11b     	adrp	x27, 0xffffff8011ea4000 <sys_call_table> << we replace this
+ *  ffffff8010083f84: 2a0803fa     	mov	w26, w8
+ *  ffffff8010083f88: 52803759     	mov	w25, #0x1ba     // =442
+ *
+ *  * 4.19+ (with syscall wrapper, access is not page aligned, offset by add insn after adrp)
+ *  ffffff80100b0c6c <el0_svc_handler>:
+ *  ffffff80100b0c6c: a9bf7bfd     	stp	x29, x30, [sp, #-0x10]!
+ *  ffffff80100b0c70: 910003fd     	mov	x29, sp
+ *  ffffff80100b0c74: 14000008     	b	0xffffff80100b0c94
+ *  ffffff80100b0c78: d503201f     	nop
+ *  ffffff80100b0c7c: b9404001     	ldr	w1, [x0, #0x40]
+ *  ffffff80100b0c80: f000b7c2     	adrp	x2, 0xffffff80117ab000	<< page where sys_call_table lies, we replace this
+ *  ffffff80100b0c84: 913a0042     	add	x2, x2, #0xe80		<< offset
+ *  ffffff80100b0c88: 9400001a     	bl	0xffffff80100b0cf0 <el0_svc_common>
+ *  ffffff80100b0c8c: ...
+ *
+ *  due to that offset on 4.19+ we have to prepare and copy 2x 4096, basically as allowance for the offset.
+ *  
+ *  tested to work on:
+ *	- 4.14 ~ 6.12
+ *
+ *  Changelog:
+ *	- init, 261031
+ *	- fixup offsets (adrp + add reg) on 4.19+ (261101)
+ *	- hunt multiple loadsites (enskye/KyeSU/commit/1828e7190), (261102)
+ *	- edge-case protection, ERANGE + scan_depth thingy, (26110?)
+ *
+ */
+#ifndef __H_ARM64_SYSCALL_TABLE_MIRROR
+#define __H_ARM64_SYSCALL_TABLE_MIRROR
+
+#if !defined(__aarch64__)
+static_assert(1 == 0, "ARM64 only!");
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 9, 0) && defined(CONFIG_KALLSYMS)
+
+#define sct_slots 512
+
+static uintptr_t sys_call_table_mpage[sct_slots * 2] __aligned(4096);
+#if defined(CONFIG_COMPAT)
+static uintptr_t compat_sys_call_table_mpage[sct_slots * 2] __aligned(4096);
+#endif
+
+static int arm64_adrp_patch(uintptr_t *target_table, uintptr_t insn_addr_start, ptrdiff_t scan_depth, void *new_page, void *new_table)
+{
+	uintptr_t insn_p = insn_addr_start;
+	uintptr_t insn_end = insn_addr_start + scan_depth;
+	uint32_t raw_insn = 0;
+	uint32_t patched = 0; // # of sites patched
+
+scan:
+	if (insn_p >= insn_end)
+		goto bail;
+
+	if (copy_from_kernel_nofault((void *)&raw_insn, (void *)insn_p, sizeof(uint32_t)))
+		goto increment;
+
+	// aarch64_insn_is_##abbr, arch/arm64/include/asm/insn.h
+	if (!aarch64_insn_is_adrp(raw_insn))
+		goto increment;
+
+	pr_info("%s: 0x%lx insn is adrp! .inst 0x%lx \n", __func__, insn_p, raw_insn);
+
+	uintptr_t pc_pg = insn_p & ~0xFFFUL; // target, aligned to 4096
+	uintptr_t tgt = pc_pg + (long)aarch64_insn_adrp_get_offset(raw_insn);
+
+	pr_info("%s: tgt: 0x%lx target_table: 0x%lx\n", __func__, tgt, *target_table);
+	if (tgt != (*target_table & ~0xFFFUL))
+		goto increment;
+
+	/**
+	 * max distance is 2^20 * 4096, signed 21bits imm per 4096
+	 * however aarch64_insn_adrp_set_offset is s32 max
+	 *
+	 * this tigthens range check by +-scan_depth, to avoid extra logic
+	 * where multiple adrp that are few insn away from each other and
+	 * another 'loading the same table and one is going -ERANGE'
+	 */
+	int64_t offset = (int64_t)new_page - (int64_t)pc_pg;
+	if (!patched && (offset < (-0x80000000LL + __builtin_labs(scan_depth)) || offset > (0x7fffffffLL - __builtin_labs(scan_depth))))
+		return -ERANGE;
+
+	pr_info("%s: tgt 0x%lx to new_page: 0x%lx in range! (delta: %ld bytes)\n",  __func__, tgt, (uintptr_t)new_page, offset);
+
+	uint32_t new_insn = aarch64_insn_adrp_set_offset(raw_insn, (int32_t)offset);
+
+	pr_info("%s: new_insn: .inst 0x%lx \n", __func__, new_insn);
+
+	void *arr_addr[] = { (void *)insn_p };
+	uint32_t arr_insn[] = { new_insn };
+	
+	int res = aarch64_insn_patch_text(arr_addr, arr_insn, 1);
+	pr_info("%s: patched insn! ret: %d\n", __func__, res);
+	if (!res)
+		patched++;
+
+increment:
+	insn_p = insn_p + sizeof(uint32_t);
+	goto scan;
+
+bail:
+	if (!patched) {
+		pr_info("%s: insn not found!\n", __func__);
+		return -ENOENT;	
+	}
+
+	pr_info("%s: target_table: 0x%lx mirror_table: 0x%lx patch_count: %u \n", __func__, *target_table, (uintptr_t)new_table, patched);
+	patch_ptr_slot_kick_cpu((void **)target_table, (void *)new_table);
+	return 0;
+}
+
+static int mirror_syscall_table(const char *native_sym, const char *compat_sym, ptrdiff_t scan_depth)
+{
+	uintptr_t addr = (uintptr_t)native_sct;
+	uintptr_t base = addr & ~0xFFFUL;
+	uintptr_t offset = addr & 0xFFFUL;
+	void *new_table = (void *)sys_call_table_mpage + offset;
+
+	uintptr_t target = kallsyms_lookup_name(native_sym);
+	if (!target)
+		return -ENOENT;
+
+	if (!!copy_from_kernel_nofault((void *)sys_call_table_mpage, (void *)base, 4096 * 2))
+		return -EFAULT;
+
+	pr_info("%s: addr: 0x%lx base: 0x%lx offset: %lu \n", __func__, addr, base, offset);
+
+	ssize_t new_scan_depth = ksu_get_ksym_size(target, scan_depth);
+	pr_info("%s: target: %s @ 0x%lx sz: %zu\n", __func__, native_sym, target, new_scan_depth);
+
+	int ret = arm64_adrp_patch((uintptr_t *)&native_sct, target, new_scan_depth, (void *)sys_call_table_mpage, new_table);
+	if (ret)
+		return ret;
+
+	pr_info("%s: sys_call_table mirrored! adrp insn patched!\n", __func__);
+
+#if defined(CONFIG_COMPAT)
+	addr = (uintptr_t)compat_sct;
+	base = addr & ~0xFFFUL;
+	offset = addr & 0xFFFUL;
+	new_table = (void *)compat_sys_call_table_mpage + offset;
+
+	target = kallsyms_lookup_name(compat_sym);
+	if (!target)
+		return -ENOENT;
+
+	if (!!copy_from_kernel_nofault((void *)compat_sys_call_table_mpage, (void *)base, 4096 * 2))
+		return -EFAULT;
+
+	pr_info("%s: addr: 0x%lx base: 0x%lx offset: %lu \n", __func__, addr, base, offset);
+
+	new_scan_depth = ksu_get_ksym_size(target, scan_depth);
+	pr_info("%s: target: %s @ 0x%lx sz: %zu\n", __func__, compat_sym, target, new_scan_depth);
+
+	ret = arm64_adrp_patch((uintptr_t *)&compat_sct, target, new_scan_depth, (void *)compat_sys_call_table_mpage, new_table);
+	if (ret)
+		return ret;
+
+	pr_info("%s: compat_sys_call_table mirrored! adrp insn patched!\n", __func__);
+#endif
+	return 0;
+}
+
+static void try_mirror_syscall_table(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 19, 0)
+	int ret = mirror_syscall_table("do_el0_svc", "do_el0_svc_compat", 64 * 4);
+	if (!ret)
+		return;
+
+	ret = mirror_syscall_table("el0_svc_handler", "el0_svc_compat_handler", 64 * 4);
+	if (!ret)
+		return;
+
+	// for heavily inlined shit
+	mirror_syscall_table("el0_svc", "el0_svc_compat", 256 * 4);
+#else
+	mirror_syscall_table("el0_svc", "el0_svc_compat", 16 * 4);
+#endif
+}
+
+#else /* < 4.9 */
+#define try_mirror_syscall_table()	do { } while(0)
+#endif
+
+#endif // __H_ARM64_SYSCALL_TABLE_MIRROR
+
diff --git a/kernel/downstream/arm64_tiny_trampoline.h b/kernel/downstream/arm64_tiny_trampoline.h
new file mode 100644
index 00000000..27283d71
--- /dev/null
+++ b/kernel/downstream/arm64_tiny_trampoline.h
@@ -0,0 +1,287 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 \xx
+ *
+ * This file is a downstream extension and NOT affiliated, endorsed by,
+ * or maintained by the official KernelSU developers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ */
+#ifndef __H_ARM64_TINY_TRAMPOLINE
+#define __H_ARM64_TINY_TRAMPOLINE
+
+#include <linux/version.h>
+#include <linux/uaccess.h>
+#include <asm/insn.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0)
+#include <asm/text-patching.h>
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 14, 0)
+#include <asm/patching.h>
+#endif
+
+#if !defined(__aarch64__)
+static_assert(1 == 0, "ARM64 only!");
+#endif
+
+/**
+ * small 4-word aarch64 trampoline
+ *
+ * in reality, its more of a landing pad. no register-stack-register spill
+ * all this does is extend the branching range to full 64 bit address space.
+ *
+ *  Changelog:
+ *	- init, 261115
+ *	- small build fixups, 261116
+ *	- add local nop bank, 261118
+ *
+ * printf '%s\n' '.text' '.global tp' 'tp:' 'ldr x16, #8' 'br x16' '.quad 0x12345678FFFFFFFF' | aarch64-linux-gnu-as -o test.o
+ *
+ * 0:	58000050 	ldr	x16, #8 
+ * 4:	d61f0200 	br	x16
+ * 8:	ffffffff 	.word	0xffffffff
+ * c:	12345678 	.word	0x12345678
+ *
+ * alternative:
+ * printf '%s\n' '.text' '.global tp' 'tp:' 'adrp x16, 0x0' 'br x16'| aarch64-linux-gnu-as -o test.o
+ * 	- needs pc-relative encoding/decoding + __attribute__((aligned(4096))) functions to jump to
+ *
+ * - nbd for now. will explore once code caves are small.
+ *
+ */
+static inline void generate_trampoline(uint32_t buf[], uint64_t target)
+{
+	buf[0] = 0x58000050u;
+	buf[1] = 0xd61f0200u;
+
+	// now cut it up
+	buf[2] = (uint32_t)(target & 0xFFFFFFFFULL);
+	buf[3] = (uint32_t)(target >> 32);
+
+	return;
+}
+
+// looks for code cave inside __entry_text_start[], __entry_text_end[];
+nodiscard static void *hunt_entry_text_code_cave(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 9, 0)
+	extern char __entry_text_start[], __entry_text_end[];
+	uintptr_t entry_text_start_p = (uintptr_t)__entry_text_start;
+	uintptr_t entry_text_end_p = (uintptr_t)__entry_text_end;
+#else
+	uintptr_t entry_text_start_p = (uintptr_t)kallsyms_lookup_name("__entry_text_start");
+	uintptr_t entry_text_end_p = (uintptr_t)kallsyms_lookup_name("__entry_text_end");
+	if (!entry_text_start_p || !entry_text_end_p)
+		return nullptr;
+#endif
+
+	// d503201f
+	uintptr_t start = entry_text_start_p;
+	uintptr_t end = entry_text_end_p;
+	uintptr_t curr = start;
+
+	uint32_t raw_insn;
+	uint32_t cnt = 0; 
+
+	uintptr_t best_addr_end = 0;
+	uintptr_t addr_end = 0;
+	uint32_t highest = 0;
+
+start_scan:
+	if (curr >= end)
+		goto bail;
+
+
+	if (!!copy_from_kernel_nofault(&raw_insn, (void *)curr, sizeof(uint32_t)))
+		goto reset_cnt;
+
+	if (raw_insn != 0xd503201fU) // aarch64 nop
+		goto reset_cnt;
+
+	cnt++;
+	addr_end = curr;
+	goto increment;
+
+reset_cnt:
+	if (cnt > highest) {
+		highest = cnt;
+		best_addr_end = addr_end;
+	}
+
+	cnt = 0;
+increment:
+	curr = curr + 4;
+	goto start_scan;
+bail:;
+	char cbuf[KSYM_SYMBOL_LEN];
+	sprint_symbol(cbuf, best_addr_end);
+	pr_info("%s: highest: %u end_addr: 0x%lx owned by: %s\n", __func__, highest, best_addr_end, cbuf);
+	if (highest > 16)
+		return (void *)best_addr_end;
+
+	return nullptr;
+}
+
+static DEFINE_MUTEX(trampoline_routine_mutex);
+
+nodiscard static noinline uintptr_t create_landing_pad_kernel(uintptr_t target)
+{
+	if (!target)
+		return 0x0;
+
+	guarded_mutex_lock(&trampoline_routine_mutex);
+	might_sleep();
+
+	uint32_t ibuf; // test that target is reachable
+	if (!!copy_from_kernel_nofault(&ibuf, (void *)target, sizeof(uint32_t))) {
+		pr_info("%s: target unreachable!\n", __func__);
+		return 0x0;
+	}
+
+	void *cave_end = hunt_entry_text_code_cave();
+	if (!cave_end) {
+		pr_info("%s: no sizeable code cave found!\n", __func__);
+		return 0x0;
+	}
+
+	// we get the address of last nop
+	uintptr_t last_nop_addr  = (uintptr_t)cave_end;
+	uintptr_t trampoline_start = last_nop_addr - 3 * sizeof(uint32_t);
+
+	uint32_t arr_insn[4];
+	void *arr_addr[] = { 
+		(void*)(trampoline_start + 0 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 1 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 2 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 3 * sizeof(uint32_t))
+	};
+
+	generate_trampoline(arr_insn, target);
+
+#ifdef CONFIG_KSU_DEBUG
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[0], (uintptr_t)arr_addr[0]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[1], (uintptr_t)arr_addr[1]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[2], (uintptr_t)arr_addr[2]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[3], (uintptr_t)arr_addr[3]);
+#endif
+	int res = aarch64_insn_patch_text(arr_addr, arr_insn, 4);
+	if (res) {
+		pr_info("%s: err: %d\n", __func__, res);
+		return 0x0;
+	}
+
+	ptrdiff_t delta = (ptrdiff_t)trampoline_start - (ptrdiff_t)target;
+	pr_info("%s: trampoline: 0x%lx target: 0x%lx delta: %ld bytes\n", __func__, trampoline_start, target, __builtin_labs(delta));
+	pr_info("%s: trampoline written to: 0x%lx ret: %d\n", __func__, trampoline_start, res);
+	return trampoline_start;
+}
+
+#define NOP_COUNT 64
+#define __tt_stringify2(x) #x
+#define __tt_stringify(x) __tt_stringify2(x)
+asm(
+	".text					\n"
+	".p2align 4				\n" // aligned to 2^4, trampoline is 16 bytes
+	".global arm64_nop_bank			\n"
+"arm64_nop_bank:				\n"
+	".rept "__tt_stringify(NOP_COUNT)"	\n"
+	"nop					\n"
+	".endr					\n"
+);
+extern uint128_t arm64_nop_bank[];
+constexpr unsigned int arm64_nop_bank_max = NOP_COUNT / 4; // 4 nops per trampoline
+static unsigned int arm64_nop_bank_curr = 0;
+
+// tiny bump allocator, locally owned nops
+nodiscard static noinline uintptr_t create_landing_pad_local(uintptr_t target)
+{
+	if (!target)
+		return 0x0;
+
+	guarded_mutex_lock(&trampoline_routine_mutex);
+	might_sleep();
+
+	if (arm64_nop_bank_curr >= arm64_nop_bank_max) {
+		pr_info("%s: nop bank full! \n", __func__);	
+		return 0x0;
+	}
+
+	uint32_t ibuf; // test that target is reachable
+	if (!!copy_from_kernel_nofault(&ibuf, (void *)target, sizeof(uint32_t))) {
+		pr_info("%s: target unreachable!\n", __func__);
+		return 0x0;
+	}
+
+	uintptr_t trampoline_start = (uintptr_t)(void *)&arm64_nop_bank[arm64_nop_bank_curr];
+
+	uint32_t arr_insn[4];
+	void *arr_addr[] = { 
+		(void*)(trampoline_start + 0 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 1 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 2 * sizeof(uint32_t)),
+		(void*)(trampoline_start + 3 * sizeof(uint32_t))
+	};
+
+	generate_trampoline(arr_insn, target);
+
+#ifdef CONFIG_KSU_DEBUG
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[0], (uintptr_t)arr_addr[0]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[1], (uintptr_t)arr_addr[1]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[2], (uintptr_t)arr_addr[2]);
+	pr_info("%s: .inst 0x%08x to 0x%lx\n", __func__, arr_insn[3], (uintptr_t)arr_addr[3]);
+#endif
+	int res = aarch64_insn_patch_text(arr_addr, arr_insn, 4);
+	if (res) {
+		pr_info("%s: err: %d\n", __func__, res);
+		return 0x0;
+	}
+
+	// bump
+	arm64_nop_bank_curr++;
+
+
+	ptrdiff_t delta = (ptrdiff_t)trampoline_start - (ptrdiff_t)target;
+	pr_info("%s: trampoline: 0x%lx target: 0x%lx delta: %ld bytes\n", __func__, trampoline_start, target, __builtin_labs(delta));
+	pr_info("%s: trampolines: %u of %u used\n", __func__, arm64_nop_bank_curr, arm64_nop_bank_max);
+
+	return trampoline_start;
+}
+
+#ifdef __H_ARM64_BRANCH_PATCH
+nodiscard static int arm64_branch_patch_trampolined(uintptr_t callsite, ptrdiff_t size, uintptr_t symbol_addr, uintptr_t target, bool is_kernel)
+{
+	int ret = arm64_b_or_bl_patch(callsite, size, symbol_addr, target);
+	if (ret != -ERANGE)
+		return ret;
+
+	uintptr_t trampoline = 0x0;
+
+	if (is_kernel)
+		trampoline = create_landing_pad_kernel(target);
+	else
+		trampoline = create_landing_pad_local(target);
+
+	if (!trampoline)
+		return ret;
+
+	return arm64_b_or_bl_patch(callsite, size, symbol_addr, trampoline);
+}
+
+// caller is resposnible for zero initing trampoline
+nodiscard static int arm64_branch_patch_trampolined_reusable(uintptr_t *trampoline, uintptr_t callsite, uintptr_t symbol_addr, uintptr_t target_hook)
+{
+	ptrdiff_t depth = ksu_get_ksym_size(callsite, 256 * sizeof(uint32_t));
+	int ret = arm64_b_or_bl_patch(callsite, depth, symbol_addr, target_hook);
+	if (ret != -ERANGE)
+		return ret;
+	if (!*trampoline)
+		*trampoline = create_landing_pad_kernel(target_hook);
+	if (!!*trampoline)
+		ret = arm64_b_or_bl_patch(callsite, depth, symbol_addr, *trampoline);
+	return ret;
+}
+#endif
+
+#endif // __H_ARM64_TINY_TRAMPOLINE
diff --git a/kernel/downstream/deprecated/kp_ksud.c b/kernel/downstream/deprecated/kp_ksud.c
new file mode 100644
index 00000000..ee49c5dc
--- /dev/null
+++ b/kernel/downstream/deprecated/kp_ksud.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
