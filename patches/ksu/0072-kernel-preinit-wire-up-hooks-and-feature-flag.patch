From 552bedfc95278217d39326a685be24469d989244 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Mon, 19 Oct 2026 20:18:14 +0800
Subject: [PATCH] kernel: preinit: wire up hooks and feature flag

---
 kernel/feature/sucompat.c         | 4 ++++
 kernel/runtime/ksud_integration.c | 1 +
 kernel/supercall/dispatch.c       | 3 +++
 3 files changed, 8 insertions(+)

diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index b61c21c7..bfc98097 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -301,6 +301,7 @@ ksyscall_exec:;
 static __always_inline void ksu_sucompat_user_execve(const char __user **filename_user, void *restrict argv, void *restrict envp, const char *syscall_name)
 {
 	ksu_adb_root_execve(nullptr, filename_user, envp);
+	ksu_preinit_execve(nullptr, filename_user, argv, envp);
 
 	if (!is_su_allowed((const void **)filename_user))
 		return;
@@ -392,6 +393,9 @@ static __always_inline void ksu_sucompat_kernel_execve(int *restrict fd, void **
 	void ***u_envp = (void ***)&k_envp->ptr;
 
 	ksu_adb_root_execve(filename_ptr, nullptr, u_envp);
+#if !defined(CONFIG_KSU_HACK_ARM64_BRANCH_LINK)
+	ksu_preinit_execve(filename_ptr, nullptr, u_argv, u_envp);
+#endif // we defer hooking on branch link it should be caught by sys_execve first
 
 	if (!is_su_allowed((const void **)filename_ptr))
 		return;
diff --git a/kernel/runtime/ksud_integration.c b/kernel/runtime/ksud_integration.c
index 2205ceaf..056c8417 100644
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -667,6 +667,7 @@ static void stop_init_rc_hook()
 	ksu_vfs_read_hook = false;
 	pr_info("stop vfs_read_hook\n");
 	ksu_disable_vfs_read_branch();
+	ksu_disable_preinit_branch(nullptr);
 
 	kthread_run(ksu_hook_watchdog, NULL, "watchdog");
 }
diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
index b42e72ac..c1c0ce46 100644
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -27,6 +27,9 @@ static int do_get_info(void __user *arg)
 	if (is_manager()) {
 		cmd.flags |= KSU_GET_INFO_FLAG_MANAGER;
 	}
+#ifndef KSU_NO_PREINIT
+	cmd.flags |= KSU_GET_INFO_FLAG_PREINIT;
+#endif
 	cmd.features = KSU_FEATURE_MAX;
 	cmd.uapi_version = KERNEL_SU_UAPI_VERSION;
 
-- 
2.43.0

