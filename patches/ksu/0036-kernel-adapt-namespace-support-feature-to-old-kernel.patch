From 87a1563a2a097186d1f582629fce6514c9027c0e Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Fri, 20 Mar 2026 20:46:01 +0800
Subject: [PATCH] kernel: adapt namespace support feature to old kernels

---
 kernel/infra/su_mount_ns.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/kernel/infra/su_mount_ns.c b/kernel/infra/su_mount_ns.c
index 48028986..8b700279 100644
--- a/kernel/infra/su_mount_ns.c
+++ b/kernel/infra/su_mount_ns.c
@@ -28,6 +28,7 @@ static void ksu_mnt_ns_global(void)
 		pwd_path = NULL;
 	}
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
 try_setns:
 
 	rcu_read_lock();
@@ -53,6 +54,24 @@ try_setns:
 		pr_warn("failed get path for init mount namespace: %ld\n", ret);
 		goto out;
 	}
+#else
+try_setns:;
+	// on UL kernels we can try to just feed it with struct path of /proc/1/ns/mnt
+	// we do NOT have ns_get_path. if it works, GOOD. if it doesn't I don't care.
+	struct path ns_path;
+	const struct cred *saved = override_creds(ksu_cred);
+
+	// make sure to LOOKUP_FOLLOW
+	// /proc/1/ns/mnt -> 'mnt:[505034]'
+	long ret = kern_path("/proc/1/ns/mnt", LOOKUP_FOLLOW, &ns_path);
+	if (ret) {
+		revert_creds(saved);
+		pr_warn("kern_path /proc/1/ns/mnt fail! ret: %d\n", ret);
+		goto out;
+	}
+	revert_creds(saved);
+#endif
+
 	struct file *ns_file = dentry_open(&ns_path, O_RDONLY, ksu_cred);
 
 	path_put(&ns_path);
-- 
2.43.0

