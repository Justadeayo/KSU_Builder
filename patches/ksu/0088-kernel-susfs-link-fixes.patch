From 1f569ce03d4ca553ce4d5c2c1931576faa8e9858 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Wed, 25 Nov 2026 11:11:22 +0100
Subject: [PATCH] susfs: link fixes

---
 kernel/Makefile               |  4 +++
 kernel/feature/sucompat.c     | 22 ++++++++----
 kernel/feature/susfs_compat.c | 68 +++++++++++++++++++++++++++++++++++
 kernel/ksu.c                  |  4 +++
 4 files changed, 91 insertions(+), 7 deletions(-)
 create mode 100644 kernel/feature/susfs_compat.c

diff --git a/kernel/Makefile b/kernel/Makefile
index 6687c3bd..8ad724ff 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -31,6 +31,10 @@ ifeq ($(shell grep -q " current_sid(void)" $(srctree)/security/selinux/include/o
 CFLAGS_ksu.o += -DKSU_COMPAT_HAS_CURRENT_SID
 endif
 
+ifeq ($(shell grep -qs "bool susfs_is_current_ksu_domain(void) {" $(srctree)/drivers/kernelsu/selinux/selinux.c $(srctree)/common/drivers/kernelsu/selinux/selinux.c; echo $$?),0)
+CFLAGS_ksu.o += -DKSU_SUSFS_SID_IN_TREE
+endif
+
 ifeq ($(shell grep -q "struct selinux_state " $(srctree)/security/selinux/include/security.h; echo $$?),0)
 CFLAGS_ksu.o += -DKSU_COMPAT_HAS_SELINUX_STATE
 endif
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index d883be0f..676b3cee 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -1,4 +1,4 @@
-#if defined(CONFIG_KSU_TAMPER_SYSCALL_TABLE) || defined(CONFIG_KSU_HACK_ARM64_BRANCH_LINK)
+#if (defined(CONFIG_KSU_TAMPER_SYSCALL_TABLE) || defined(CONFIG_KSU_HACK_ARM64_BRANCH_LINK)) && !defined(CONFIG_KSU_SUSFS)
 #define SUCOMPAT_HOOK_TYPE static __always_inline int
 #else
 #define SUCOMPAT_HOOK_TYPE int
@@ -7,7 +7,15 @@
 #define SU_PATH "/system/bin/su"
 #define SH_PATH "/system/bin/sh"
 
+#ifdef CONFIG_KSU_SUSFS
+DEFINE_STATIC_KEY_TRUE(ksu_su_compat_enabled);
+#define KSU_SU_COMPAT_ON() static_branch_likely(&ksu_su_compat_enabled)
+#define KSU_SU_COMPAT_SET(v) ((v) ? static_branch_enable(&ksu_su_compat_enabled) : static_branch_disable(&ksu_su_compat_enabled))
+#else
 static bool ksu_su_compat_enabled __read_mostly = true;
+#define KSU_SU_COMPAT_ON() (ksu_su_compat_enabled)
+#define KSU_SU_COMPAT_SET(v) (ksu_su_compat_enabled = (v))
+#endif
 
 static char __user *sh_user_path(void)
 {
@@ -59,7 +67,7 @@ static __always_inline bool is_su_allowed(const void **ptr_to_check)
 	if (!!!static_branch_likely(&ksu_sucompat_key))
 		return false;
 #else
-	if (!ksu_su_compat_enabled)
+	if (!KSU_SU_COMPAT_ON())
 		return false;
 #endif // KSU_CAN_USE_JUMP_LABEL
 #endif
@@ -475,7 +483,7 @@ static void ksu_sucompat_enable()
 	ksu_sucompat_enable_branch();
 	syscall_table_sucompat_enable();
 
-	ksu_su_compat_enabled = true;
+	KSU_SU_COMPAT_SET(true);
 	pr_info("%s: hooks enabled: exec, faccessat, stat\n", __func__);
 }
 
@@ -485,13 +493,13 @@ static void ksu_sucompat_disable()
 	ksu_sucompat_disable_branch();
 	syscall_table_sucompat_disable();
 
-	ksu_su_compat_enabled = false;
+	KSU_SU_COMPAT_SET(false);
 	pr_info("%s: hooks disabled: exec, faccessat, stat\n", __func__);
 }
 
 static int su_compat_feature_get(u64 *value)
 {
-	*value = ksu_su_compat_enabled ? 1 : 0;
+	*value = KSU_SU_COMPAT_ON() ? 1 : 0;
 	return 0;
 }
 
@@ -499,7 +507,7 @@ static int su_compat_feature_set(u64 value)
 {
 	bool enable = value != 0;
 
-	if (enable == ksu_su_compat_enabled) {
+	if (enable == KSU_SU_COMPAT_ON()) {
 		pr_info("su_compat: no need to change\n");
 	return 0;
 	}
@@ -510,7 +518,7 @@ static int su_compat_feature_set(u64 value)
 		ksu_sucompat_disable();
 	}
 
-	ksu_su_compat_enabled = enable;
+	KSU_SU_COMPAT_SET(enable);
 	pr_info("su_compat: set to %d\n", enable);
 
 	return 0;
diff --git a/kernel/feature/susfs_compat.c b/kernel/feature/susfs_compat.c
new file mode 100644
index 00000000..5c6e92e9
--- /dev/null
+++ b/kernel/feature/susfs_compat.c
@@ -0,0 +1,68 @@
+#ifdef CONFIG_KSU_SUSFS
+
+DEFINE_STATIC_KEY_TRUE(ksu_is_init_rc_hook_enabled);
+DEFINE_STATIC_KEY_TRUE(ksu_is_input_hook_enabled);
+
+int ksu_handle_sys_read(unsigned int fd)
+{
+	ksu_handle_sys_read_fd(fd);
+	return 0;
+}
+
+void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr)
+{
+}
+
+int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code, int *value)
+{
+	return 0;
+}
+
+int ksu_handle_setresuid(uid_t ruid, uid_t euid, uid_t suid)
+{
+	return 0;
+}
+
+int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags)
+{
+	return ksu_handle_execveat(fd, filename_ptr, argv, envp, flags);
+}
+
+int ksu_handle_post_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags, int *retval)
+{
+	return 0;
+}
+
+#ifndef KSU_SUSFS_SID_IN_TREE
+bool susfs_is_current_ksu_domain(void)
+{
+	return is_ksu_domain();
+}
+#endif
+
+int susfs_add_sus_avd_allowed_by_type(u32 s_type, u32 t_type, u32 c_type, u32 orig_avd_allowed)
+{
+	return 0;
+}
+
+int susfs_add_sus_type(const char *secctx, u32 type_value)
+{
+	return 0;
+}
+
+#ifndef MODULE
+int ksu_hide_setprocattr(const char *name, void *value, size_t size)
+{
+	return 0;
+}
+
+static int __init ksu_susfs_compat_init(void)
+{
+	static_branch_disable(&ksu_is_init_rc_hook_enabled);
+	static_branch_disable(&ksu_is_input_hook_enabled);
+	return 0;
+}
+early_initcall(ksu_susfs_compat_init);
+#endif
+
+#endif
diff --git a/kernel/ksu.c b/kernel/ksu.c
index 3eff0121..c9bdb441 100644
--- a/kernel/ksu.c
+++ b/kernel/ksu.c
@@ -166,6 +166,10 @@
 #include "selinux/sepolicy.c"
 #include "selinux/rules.c"
 
+#ifdef CONFIG_KSU_SUSFS
+#include "feature/susfs_compat.c"
+#endif
+
 #ifdef CONFIG_KSU_TAMPER_SYSCALL_TABLE
 #ifdef CONFIG_ARM64
 	#include "hook/syscall_table_hook_arm64.c"
