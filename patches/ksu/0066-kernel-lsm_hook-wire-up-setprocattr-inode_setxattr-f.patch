From 3db25c5ed392b49bd587654d7fbbb45ed9dd123a Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Sun, 17 May 2026 14:17:27 +0800
Subject: [PATCH] kernel: lsm_hook: wire up setprocattr and inode_setxattr for selinux_hide

---
 kernel/hook/lsm_hooks_list.c        |  85 +++++++++++++++++++++++
 kernel/hook/lsm_hooks_manual.c      |  33 +++++++++
 kernel/hook/lsm_hooks_static.c      | 102 ++++++++++++++++++++++++++++
 kernel/hook/lsm_hooks_ultralegacy.c |  31 +++++++++
 4 files changed, 251 insertions(+)

diff --git a/kernel/hook/lsm_hooks_list.c b/kernel/hook/lsm_hooks_list.c
index 8d832933..c1f10b73 100644
--- a/kernel/hook/lsm_hooks_list.c
+++ b/kernel/hook/lsm_hooks_list.c
@@ -60,6 +60,64 @@ capability_fn:
 }
 #endif
 
+#define SETPROCATTR_TYPE_task	struct task_struct *p, char *name, void *, size_t
+#define SETPROCATTR_TYPE_name	const char *name, void *, size_t
+#define SETPROCATTR_TYPE_lsm	const char *lsm, const char *name, void *, size_t
+#define SETPROCATTR_TYPE_lsmid	int lsmid, const char *name, void *, size_t
+
+static void *setprocattr_fn __read_mostly = nullptr;
+__overloaded static __nocfi int ksu_setprocattr_new(const char *name, void *value, size_t size)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+	return ((typeof(ksu_setprocattr_new) *)setprocattr_fn)(name, value, size);
+}
+
+__overloaded static __nocfi int ksu_setprocattr_task(struct task_struct *p, char *name, void *value, size_t size)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+	return ((typeof(ksu_setprocattr_task) *)setprocattr_fn)(p, name, value, size);
+}
+
+#define ksu_setprocattr_overloaded _Generic(			\
+(security_setprocattr),						\
+	int (*)(SETPROCATTR_TYPE_task)  :ksu_setprocattr_task,	\
+	int (*)(SETPROCATTR_TYPE_name)  :ksu_setprocattr_new, 	\
+	int (*)(SETPROCATTR_TYPE_lsm)   :ksu_setprocattr_new,	\
+	int (*)(SETPROCATTR_TYPE_lsmid) :ksu_setprocattr_new	\
+)
+
+static void *inode_setxattr_fn __read_mostly = nullptr;
+
+struct mnt_idmap;
+#define INODE_SETXATTR_TYPE_idmap	struct mnt_idmap *idmap, struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static __nocfi int ksu_inode_setxattr_idmap(INODE_SETXATTR_TYPE_idmap)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+	return ((typeof(ksu_inode_setxattr_idmap) *)inode_setxattr_fn)(idmap, dentry, name, value, size, flags);
+}
+
+struct user_namespace;
+#define INODE_SETXATTR_TYPE_userns	struct user_namespace *mnt_userns, struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static __nocfi int ksu_inode_setxattr_userns(INODE_SETXATTR_TYPE_userns)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+	return ((typeof(ksu_inode_setxattr_userns) *)inode_setxattr_fn)(mnt_userns, dentry, name, value, size, flags);
+}
+
+#define INODE_SETXATTR_TYPE_legacy	struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static __nocfi int ksu_inode_setxattr_legacy(INODE_SETXATTR_TYPE_legacy)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+	return ((typeof(ksu_inode_setxattr_legacy) *)inode_setxattr_fn)(dentry, name, value, size, flags);
+}
+
+#define ksu_inode_setxattr_overloaded _Generic(				\
+(security_inode_setxattr),						\
+	int (*)(INODE_SETXATTR_TYPE_idmap)  :ksu_inode_setxattr_idmap,	\
+	int (*)(INODE_SETXATTR_TYPE_userns) :ksu_inode_setxattr_userns, \
+	int (*)(INODE_SETXATTR_TYPE_legacy) :ksu_inode_setxattr_legacy 	\
+)
+
 /**
  *
  * Instead of using list/hlist abstractions and shit, since we know these things exist
@@ -228,11 +286,27 @@ static int ksu_restore_bprm_set_creds(void *data)
 }
 #endif
 
+static void ksu_decide_inode_setxattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	LSM_HACK_RESTORE(inode_setxattr);
+}
+static void ksu_decide_setprocattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	LSM_HACK_RESTORE(setprocattr);
+}
+
 static __init void ksu_lsm_hook_init(void)
 {
 	LSM_HACK_INIT(task_fix_setuid, ksu_task_fix_setuid);
 	LSM_HACK_INIT(inode_rename, ksu_inode_rename);
 
+	LSM_HACK_INIT(setprocattr, ksu_setprocattr_overloaded);
+	LSM_HACK_INIT(inode_setxattr, ksu_inode_setxattr_overloaded);
+
 #if !defined(CONFIG_KSU_TAMPER_SYSCALL_TABLE) && !defined(CONFIG_KSU_HACK_ARM64_BRANCH_LINK)
 	LSM_HACK_INIT(file_permission, ksu_file_permission);
 	kthread_run(ksu_restore_file_permission, NULL, "kthread");
@@ -244,3 +318,14 @@ static __init void ksu_lsm_hook_init(void)
 #endif
 
 }
+
+#undef INODE_SETXATTR_TYPE_idmap
+#undef INODE_SETXATTR_TYPE_userns
+#undef INODE_SETXATTR_TYPE_legacy
+#undef ksu_inode_setxattr_overloaded
+
+#undef SETPROCATTR_TYPE_task
+#undef SETPROCATTR_TYPE_name
+#undef SETPROCATTR_TYPE_lsm
+#undef SETPROCATTR_TYPE_lsmid
+#undef ksu_setprocattr_overloaded
diff --git a/kernel/hook/lsm_hooks_manual.c b/kernel/hook/lsm_hooks_manual.c
index 60439861..30bac6dc 100644
--- a/kernel/hook/lsm_hooks_manual.c
+++ b/kernel/hook/lsm_hooks_manual.c
@@ -47,7 +47,40 @@ int ksu_file_permission(struct file *file, int mask)
 	return 0;
 }
 
+static bool lsm_procattr_hook __read_mostly = true;
+int ksu_hide_setprocattr(const char *name, void *value, size_t size)
+{
+	if (lsm_procattr_hook)
+		ksu_hide_setprocattr_inline(name, value, size);
+	return 0;
+}
+
+// NOTE: 4-args only. other args unused.
+static bool lsm_setxattr_hook __read_mostly = true;
+int ksu_hide_inode_setxattr(struct dentry *dentry, const char *name, void *value, size_t *size, int *flags)
+{
+	if (lsm_setxattr_hook)
+		ksu_hide_setxattr_inline(name, value, *size);
+	return 0;
+}
+
 static void __init ksu_lsm_hook_init(void)
 {
 	pr_info("%s: Automated LSM hooking disabled. Make sure manual security hooks are implemented!\n", __func__);
 }
+
+static void ksu_decide_inode_setxattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	lsm_setxattr_hook = false;
+	pr_info("LSM: security_inode_setxattr unhooked!\n");
+}
+static void ksu_decide_setprocattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	lsm_procattr_hook = false;
+	pr_info("LSM: security_inode_procattr unhooked!\n");
+}
+
diff --git a/kernel/hook/lsm_hooks_static.c b/kernel/hook/lsm_hooks_static.c
index 40eeeee5..ccd0e2e7 100644
--- a/kernel/hook/lsm_hooks_static.c
+++ b/kernel/hook/lsm_hooks_static.c
@@ -117,6 +117,76 @@ loop_start:
 }
 #endif // !CONFIG_KSU_TAMPER_SYSCALL_TABLE && !CONFIG_KSU_HACK_ARM64_BRANCH_LINK
 
+#define SETPROCATTR_TYPE_lsmid	int lsmid, const char *name, void *value, size_t size
+__overloaded static int ksu_setprocattr_lsmid(SETPROCATTR_TYPE_lsmid)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+
+	assume(!!&security_setprocattr);
+	return ((typeof(ksu_setprocattr_lsmid) *)(void *)security_setprocattr)(lsmid, name, value, size);
+}
+
+#define SETPROCATTR_TYPE_lsm	const char *lsm, const char *name, void *value, size_t size
+__overloaded static int ksu_setprocattr_lsm(SETPROCATTR_TYPE_lsm)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+
+	assume(!!&security_setprocattr);
+	return ((typeof(ksu_setprocattr_lsm) *)(void *)security_setprocattr)(lsm, name, value, size);
+}
+
+#define SETPROCATTR_TYPE_name	const char *name, void *value, size_t size
+__overloaded static int ksu_setprocattr_name(SETPROCATTR_TYPE_name)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+
+	assume(!!&security_setprocattr);
+	return ((typeof(ksu_setprocattr_name) *)(void *)security_setprocattr)(name, value, size);
+}
+
+#define ksu_setprocattr_overloaded _Generic(			\
+(security_setprocattr),						\
+	int (*)(SETPROCATTR_TYPE_lsmid)	:ksu_setprocattr_lsmid,	\
+	int (*)(SETPROCATTR_TYPE_lsm)	:ksu_setprocattr_lsm,	\
+	int (*)(SETPROCATTR_TYPE_name)	:ksu_setprocattr_name	\
+)
+
+struct mnt_idmap;
+#define INODE_SETXATTR_TYPE_idmap	struct mnt_idmap *idmap, struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static int ksu_inode_setxattr_idmap(INODE_SETXATTR_TYPE_idmap)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+
+	assume(!!&security_inode_setxattr);
+	return ((typeof(ksu_inode_setxattr_idmap) *)(void *)security_inode_setxattr)(idmap, dentry, name, value, size, flags);
+}
+
+struct user_namespace;
+#define INODE_SETXATTR_TYPE_userns	struct user_namespace *mnt_userns, struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static int ksu_inode_setxattr_userns(INODE_SETXATTR_TYPE_userns)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+
+	assume(!!&security_inode_setxattr);
+	return ((typeof(ksu_inode_setxattr_userns) *)(void *)security_inode_setxattr)(mnt_userns, dentry, name, value, size, flags);
+}
+
+#define INODE_SETXATTR_TYPE_legacy	struct dentry *dentry, const char *name, const void *value, size_t size, int flags
+__overloaded static int ksu_inode_setxattr_legacy(INODE_SETXATTR_TYPE_legacy)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+
+	assume(!!&security_inode_setxattr);
+	return ((typeof(ksu_inode_setxattr_legacy) *)(void *)security_inode_setxattr)(dentry, name, value, size, flags);
+}
+
+#define ksu_inode_setxattr_overloaded _Generic(				\
+(security_inode_setxattr),						\
+	int (*)(INODE_SETXATTR_TYPE_idmap)  :ksu_inode_setxattr_idmap,	\
+	int (*)(INODE_SETXATTR_TYPE_userns) :ksu_inode_setxattr_userns,	\
+	int (*)(INODE_SETXATTR_TYPE_legacy) :ksu_inode_setxattr_legacy	\
+)
+
 #define __ksym_size(callsite)	ksu_get_ksym_size(callsite, (256 * sizeof(uint32_t)))
 static void print_branch_targets(uintptr_t callsite, uintptr_t symbol_addr, char *hook_name)
 {
@@ -177,5 +247,37 @@ rename_hook_done:
 
 }
 
+// see selinux_hide.c
+static void ksu_decide_inode_setxattr(bool sh_hooked)
+{
+	if (sh_hooked)
+		return;
+	uintptr_t target_callsite = kallsyms_lookup_retry("__vfs_setxattr_locked"); // exported symbol
+	uintptr_t symbol_addr = kallsyms_lookup_retry("security_inode_setxattr");
+	int ret = patch_arm64_branches_trampolined(target_callsite, symbol_addr, ksu_inode_setxattr_overloaded);
+	pr_info("LSM: security_inode_setxattr: ret %d \n", ret);
+}
+
+static void ksu_decide_setprocattr(bool sh_hooked)
+{
+	if (sh_hooked)
+		return;
+	uintptr_t target_callsite = kallsyms_lookup_retry("proc_pid_attr_write"); // fn ptr on dispatch table
+	uintptr_t symbol_addr = kallsyms_lookup_retry("security_setprocattr");
+	int ret = patch_arm64_branches_trampolined(target_callsite, symbol_addr, ksu_setprocattr_overloaded);
+	pr_info("LSM: security_setprocattr: ret %d \n", ret);
+}
+
 #undef patch_arm64_branches_trampolined
 #undef __ksym_size
+
+#undef INODE_SETXATTR_TYPE_idmap
+#undef INODE_SETXATTR_TYPE_userns
+#undef INODE_SETXATTR_TYPE_idmap
+#undef ksu_inode_setxattr_overloaded
+
+#undef SETPROCATTR_TYPE_lsmid
+#undef SETPROCATTR_TYPE_lsm
+#undef SETPROCATTR_TYPE_name
+#undef ksu_setprocattr_overloaded
+
diff --git a/kernel/hook/lsm_hooks_ultralegacy.c b/kernel/hook/lsm_hooks_ultralegacy.c
index 28dda023..786c093d 100644
--- a/kernel/hook/lsm_hooks_ultralegacy.c
+++ b/kernel/hook/lsm_hooks_ultralegacy.c
@@ -15,6 +15,20 @@
 
 static uintptr_t selinux_ops_addr = 0x0;
 
+static int (*orig_setprocattr)(struct task_struct *p, char *name, void *value, size_t size) __read_mostly = nullptr;
+static int ksu_setprocattr(struct task_struct *p, char *name, void *value, size_t size)
+{
+	ksu_hide_setprocattr_inline(name, value, size);
+	return orig_setprocattr(p, name, value, size);
+}
+
+static int (*orig_inode_setxattr)(struct dentry *dentry, const char *name, const void *value, size_t size, int flags) __read_mostly = nullptr;
+static int ksu_inode_setxattr(struct dentry *dentry, const char *name, const void *value, size_t size, int flags)
+{
+	ksu_hide_setxattr_inline(name, value, size);
+	return orig_inode_setxattr(dentry, name, value, size, flags);
+}
+
 static int (*orig_inode_rename) (struct inode *old_dir, struct dentry *old_dentry,
 			     struct inode *new_dir, struct dentry *new_dentry) __read_mostly = nullptr;
 static int ksu_inode_rename(struct inode *old_inode, struct dentry *old_dentry,
@@ -323,6 +337,20 @@ static int ksu_restore_bprm_set_creds(void *data)
 	return 0;
 }
 
+static void ksu_decide_inode_setxattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	LSM_HACK_RESTORE(inode_setxattr);
+}
+
+static void ksu_decide_setprocattr(bool sh_hooked)
+{
+	if (!sh_hooked)
+		return;
+	LSM_HACK_RESTORE(setprocattr);
+}
+
 static inline void ksu_register_lsm_hook(void)
 {
 	LSM_HACK_INIT(task_fix_setuid, ksu_task_fix_setuid);
@@ -331,6 +359,9 @@ static inline void ksu_register_lsm_hook(void)
 	LSM_HACK_INIT(bprm_set_creds, ksu_bprm_set_creds);
 	kthread_run(ksu_restore_bprm_set_creds, NULL, "kthread");
 
+	LSM_HACK_INIT(setprocattr, ksu_setprocattr);
+	LSM_HACK_INIT(inode_setxattr, ksu_inode_setxattr);
+
 #if !defined(CONFIG_KSU_TAMPER_SYSCALL_TABLE) && !defined(CONFIG_KSU_HACK_ARM64_BRANCH_LINK)
 	LSM_HACK_INIT(file_permission, ksu_file_permission);
 	kthread_run(ksu_restore_file_permission, nullptr, "kthread");
-- 
2.43.0

