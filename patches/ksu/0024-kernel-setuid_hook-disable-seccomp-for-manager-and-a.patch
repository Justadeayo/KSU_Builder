From 3e5f71a8a97bed49f32199e1e986f56f3bf8b511 Mon Sep 17 00:00:00 2001
From: Justus <justadeayo@gmail.com>
Date: Sun, 2 Nov 2025 00:14:07 +0800
Subject: [PATCH] kernel: setuid_hook: disable seccomp for manager and allowed uids

---
 kernel/hook/lsm_hooks_list.c        |  4 ++++
 kernel/hook/lsm_hooks_manual.c      |  4 ++++
 kernel/hook/lsm_hooks_static.c      |  8 +++++++
 kernel/hook/lsm_hooks_ultralegacy.c |  4 ++++
 kernel/hook/setuid_hook.c           | 36 +++++++++++++++++++++++++++++
 kernel/ksu.c                        |  3 ++-
 6 files changed, 58 insertions(+), 1 deletion(-)
 create mode 100644 kernel/hook/setuid_hook.c

diff --git a/kernel/hook/lsm_hooks_list.c b/kernel/hook/lsm_hooks_list.c
index f6143aa2..bbef4201 100644
--- a/kernel/hook/lsm_hooks_list.c
+++ b/kernel/hook/lsm_hooks_list.c
@@ -16,6 +16,10 @@ extern struct security_hook_heads security_hook_heads;
 static int (*task_fix_setuid_fn)(struct cred *new, const struct cred *old, int flags) __read_mostly = nullptr;
 static __nocfi int ksu_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
 {
+	// see sys_setresuid
+	if (flags == LSM_SETID_RES)
+		ksu_handle_setresuid_cred(new, old);
+
 	return task_fix_setuid_fn(new, old, flags);
 }
 
diff --git a/kernel/hook/lsm_hooks_manual.c b/kernel/hook/lsm_hooks_manual.c
index 45fdf650..35ef3b50 100644
--- a/kernel/hook/lsm_hooks_manual.c
+++ b/kernel/hook/lsm_hooks_manual.c
@@ -20,6 +20,10 @@ int ksu_inode_rename(struct inode *old_inode, struct dentry *old_dentry,
 
 int ksu_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
 {
+	// see sys_setresuid
+	if (flags == LSM_SETID_RES)
+		ksu_handle_setresuid_cred(new, old);
+
 	return 0;
 }
 
diff --git a/kernel/hook/lsm_hooks_static.c b/kernel/hook/lsm_hooks_static.c
index f61976aa..beb47c90 100644
--- a/kernel/hook/lsm_hooks_static.c
+++ b/kernel/hook/lsm_hooks_static.c
@@ -43,6 +43,10 @@ static int ksu_inode_rename(struct inode *old_dir, struct dentry *old_dentry, st
 extern int security_task_fix_setuid(struct cred *new, const struct cred *old, int flags);
 static int ksu_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
 {
+	// see sys_setresuid
+	if (flags == LSM_SETID_RES)
+		ksu_handle_setresuid_cred(new, old);
+
 	return security_task_fix_setuid(new, old, flags);
 }
 
@@ -54,6 +58,8 @@ asmlinkage long hook_aarch64_setresuid(const struct pt_regs *regs)
 	const struct cred old = *current_cred();
 
 	long ret = __arm64_sys_setresuid(regs);
+	if (!ret)
+		ksu_handle_setresuid_cred(current_cred(), &old);
 	return ret;
 }
 
@@ -66,6 +72,8 @@ asmlinkage long hook_armeabi_setresuid(const struct pt_regs *regs)
 	const struct cred old = *current_cred();
 
 	long ret = __arm64_sys_setresuid(regs);
+	if (!ret)
+		ksu_handle_setresuid_cred(current_cred(), &old);
 	return ret;
 }
 #endif
diff --git a/kernel/hook/lsm_hooks_ultralegacy.c b/kernel/hook/lsm_hooks_ultralegacy.c
index 9b47a87d..82a098b2 100644
--- a/kernel/hook/lsm_hooks_ultralegacy.c
+++ b/kernel/hook/lsm_hooks_ultralegacy.c
@@ -27,6 +27,10 @@ static int ksu_inode_rename(struct inode *old_inode, struct dentry *old_dentry,
 static int (*orig_task_fix_setuid) (struct cred *new, const struct cred *old, int flags) __read_mostly = nullptr;
 static int ksu_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
 {
+	// see sys_setresuid
+	if (flags == LSM_SETID_RES)
+		ksu_handle_setresuid_cred(new, old);
+
 	return orig_task_fix_setuid(new, old, flags);
 }
 
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
new file mode 100644
index 00000000..a7e80ef1
--- /dev/null
+++ b/kernel/hook/setuid_hook.c
@@ -0,0 +1,36 @@
+static __always_inline void ksu_handle_setresuid_cred(struct cred *new, const struct cred *old)
+{
+	if (!new || !old)
+		return;
+
+	uid_t new_uid = new->uid.val;
+	uid_t old_uid = old->uid.val;
+
+	// old process is not root, ignore it.
+	if (unlikely(!!old_uid))
+		return;
+
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
+
+	// we dont have those new fancy things upstream has
+	// lets just do the original thing where we disable seccomp
+	if (unlikely(is_uid_manager(new_uid)))
+		goto install_ksu_fd;
+
+	if (ksu_is_allow_uid_for_current(new_uid))
+		goto kill_seccomp;
+
+	// Handle kernel umount
+	ksu_handle_umount(new, old);
+	return;
+
+install_ksu_fd:
+	pr_info("install fd for manager: %d\n", new_uid);
+	ksu_install_fd();
+
+kill_seccomp:
+	disable_seccomp();
+	set_thread_flag(TIF_KSU_MANAGED); // sucompat fast-path
+	return;
+}
diff --git a/kernel/ksu.c b/kernel/ksu.c
index 05bf82ae..5dca0891 100644
--- a/kernel/ksu.c
+++ b/kernel/ksu.c
@@ -106,6 +106,8 @@
 #include "sulog/event.c"
 #include "sulog/fd.c"
 
+#include "hook/setuid_hook.c"
+
 #ifdef CONFIG_KSU_LSM_SECURITY_HOOKS
 	#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0) || defined(LSM_USES_BRANCH_LINK)
 	#include "hook/lsm_hooks_static.c"
@@ -118,7 +120,6 @@
 	#include "hook/lsm_hooks_manual.c"
 #endif
 
-
 #include "selinux/selinux.c"
 #include "selinux/sepolicy.c"
 #include "selinux/rules.c"
-- 
