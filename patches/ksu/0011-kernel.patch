-void setup_mount_ns(int32_t ns_mode)
-{
-    // inherit mode
-    if (ns_mode == KSU_NS_INHERITED) {
-        // do nothing
-        return;
-    }
-
-    if (ns_mode != KSU_NS_GLOBAL && ns_mode != KSU_NS_INDIVIDUAL) {
-        pr_warn("pid: %d ,unknown mount namespace mode: %d\n", current->pid, ns_mode);
-        return;
-    }
