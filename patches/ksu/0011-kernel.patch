-
-    isec = ksu_selinux_inode(inode);
-    if (IS_ERR(isec))
-        return PTR_ERR(isec);
-    // Match backing_inode_security: keep old label if reload fails
-    if (READ_ONCE(isec->initialized) != LABEL_INITIALIZED)
