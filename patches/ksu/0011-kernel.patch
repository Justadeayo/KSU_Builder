-#if HAVE_ON_EACH_MATCH_SYMBOL
-// Equal names are ordered by address, i.e. kallsyms order: keep the first.
-static int ksu_first_match_cb(void *data, unsigned long addr)
-{
-    *(unsigned long *)data = addr;
-    return 1;
-}
