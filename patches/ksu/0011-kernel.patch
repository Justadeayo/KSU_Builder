-
-    Elf64_Sym *ko_syms = (Elf64_Sym *)((char *)ko_elf.data + ko_symtab->sh_offset);
-    int ko_sym_count = ko_symtab->sh_size / sizeof(Elf64_Sym);
-
-    int has_error = 0;
-
-    for (int i = 0; i < ko_sym_count; i++) {
