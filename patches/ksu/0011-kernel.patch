-({                                                                            \
-	register long _num __asm__ ("r3") = (num);                            \
-	register long _ret __asm__ ("r0");                                    \
-									      \
-	__asm__ volatile (                                                    \
-		"trapa #31"                                                   \
-		: "=r"(_ret)                                                  \
-		: "r"(_num)                                                   \
-		: "memory", "cc"                                              \
-	);                                                                    \
-	_ret;                                                                 \
