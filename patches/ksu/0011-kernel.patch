-    if (task) {
-        get_task_struct(task);
-        rcu_read_unlock();
-        if (mark) {
-            ksu_set_task_tracepoint_flag(task);
-        } else {
-            ksu_clear_task_tracepoint_flag(task);
-        }
-        put_task_struct(task);
