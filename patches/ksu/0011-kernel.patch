-
-    p = get_user_arg_ptr(argv, index);
-    if (!p || IS_ERR(p))
-        goto fail;
-
-    if (strncpy_from_user_nofault(buf, p, buf_len) <= 0)
-        goto fail;
-
-    buf[buf_len - 1] = '\0';
-    return !strcmp(buf, expected);
-
-fail:
-    pr_err("check_argv failed\n");
-    return false;
