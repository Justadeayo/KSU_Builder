-struct selinux_policy *ksu_dup_sepolicy(struct selinux_policy *old_pol)
-{
-    int ret;
-    size_t len;
-    struct selinux_policy *new_pol;
-    void *data;
-    struct policy_file fp;
-
-    // Some device policy db seems not marking type itself in type_attr_map_array
