+#endif
+static void *armeabi_execveat __read_mostly = nullptr;
+asmlinkage long hook_armeabi_execveat(int fd, const char __user * filename, const compat_uptr_t __user * argv, const compat_uptr_t __user * envp, int flags)
+{
