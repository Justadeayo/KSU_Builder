 				node->datum.u.data &= ~(1U << (perm->value - 1));
@@ -1013,6 +1022,9 @@ static bool add_type(struct policydb *db, const char *type_name, bool attr)
 		ebitmap_set_bit(&db->role_val_to_struct[i]->types, value - 1,
 				1);
