  * Adapt to Huawei HISI kernel without affecting other kernels ,
  * Huawei Hisi Kernel EBITMAP Enable or Disable Flag ,
@@ -339,6 +344,10 @@ static bool add_rule_raw(struct policydb *db, struct type_datum *src, struct typ
 				return false;
 		}
 
