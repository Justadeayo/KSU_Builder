From: Justus <justadeayo@gmail.com>
Subject: [PATCH] kernel: build: disable kprobes & enable syscall table tampering

Signed-off-by: Justus <justadeayo@gmail.com>
---
 kernel/Kconfig | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/kernel/Kconfig b/kernel/Kconfig
index beae401c..0b999e5e 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -14,7 +14,6 @@ config KSU_HACK_ARM64_BRANCH_LINK
 	depends on KSU
 	depends on ARM64 && KALLSYMS
 	depends on !KSU_TAMPER_SYSCALL_TABLE
-	default y if KSU = m
 	default n
 	help
 	  Opportunistically attempts to provide faster sucompat by scanning kernel text
@@ -29,7 +28,7 @@ config KSU_TAMPER_SYSCALL_TABLE
 	bool "tamper sys_call_table for sucompat + sys_reboot"
 	depends on KSU
 	depends on (ARM || ARM64)
-	default n
+	default y
 	help
 	  Use a high-performance syscall table hijacking method demonstrated on zx2c4's
 	  kernel-assisted-superuser. Replaces sys_reboot, sys_execve, sys_newfstatat,
-- 
2.43.0

