From: Justus <justadeayo@gmail.com>
Subject: [PATCH] kernel: build: enable hostsredirect feature by default

Signed-off-by: Justus <justadeayo@gmail.com>
---
 kernel/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel/Kconfig b/kernel/Kconfig
index 0b999e5e..1ab53109 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -73,7 +73,7 @@ config KSU_HOSTSREDIRECT
 	bool "/system/etc/hosts redirection"
 	depends on KSU
 	depends on (ARM || ARM64)
-	default n
+	default y
 	help
 	  Kernel-level sys_openat fd redirect targeting /system/etc/hosts to /data/adb/hosts.
 	  Allows hosts file modification without mounting hosts file directly, this is meant to
-- 
2.43.0

