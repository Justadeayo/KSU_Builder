From: Justus <justadeayo@gmail.com>
Subject: [PATCH] kernel: qol: move these logs to KSU_DEBUG

Signed-off-by: Justus <justadeayo@gmail.com>
---
 kernel/manager/throne_tracker.c |  6 ++++--
 kernel/policy/allowlist.c       |  7 +++++--
 kernel/supercall/supercall.c    | 12 +++++++++---
 3 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/kernel/manager/throne_tracker.c b/kernel/manager/throne_tracker.c
index b116c29d..30640268 100644
--- a/kernel/manager/throne_tracker.c
+++ b/kernel/manager/throne_tracker.c
@@ -359,7 +359,8 @@ static int throne_tracker_thread(void *data)
 	// now de-void it here
 	bool prune_only = (bool)data;
 
-	pr_info("throne_tracker: pid: %d started\n", current->pid);
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("throne_tracker: pid: %d started\n", current->pid);
 
 	guarded_mutex_lock(&throne_tracker_mutex);
 
@@ -391,7 +392,8 @@ start_tt:
 	escape_to_root_forced();
 	throne_tracker_fn(prune_only);
 
-	pr_info("throne_tracker: pid: %d exit!\n", current->pid);
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("throne_tracker: pid: %d exit!\n", current->pid);
 	return 0;
 }
 
diff --git a/kernel/policy/allowlist.c b/kernel/policy/allowlist.c
index 8030971a..e3529707 100644
--- a/kernel/policy/allowlist.c
+++ b/kernel/policy/allowlist.c
@@ -401,10 +401,13 @@ static int persistent_allow_list_pre(void *data)
 	 * 'mutex-trylock-fail-then-return' is detrimental here
 	 */
 	guarded_mutex_lock(&allowlist_mutex);
-	pr_info("do_persistent_allow_list: pid: %d started\n", current->pid);
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("do_persistent_allow_list: pid: %d started\n", current->pid);
 	escape_to_root_forced(); // give permissions for everything
 	do_persistent_allow_list();
-	pr_info("do_persistent_allow_list: pid: %d exit\n", current->pid);
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("do_persistent_allow_list: pid: %d exit\n", current->pid);
+
 	return 0;
 }
 
diff --git a/kernel/supercall/supercall.c b/kernel/supercall/supercall.c
index baa2840c..d4a15a3b 100644
--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -13,7 +13,9 @@ struct ksu_driver_context {
 static int anon_ksu_release(struct inode *inode, struct file *filp)
 {
 	kfree(filp->private_data);
-	pr_info("ksu fd released\n");
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("ksu fd released\n");
+
 	return 0;
 }
 
@@ -61,7 +63,9 @@ static int ksu_install_fd_with_permissions(unsigned int fd_flags, unsigned long
 	}
 
 	fd_install(fd, filp);
-	pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
+	if (IS_ENABLED(CONFIG_KSU_DEBUG))
+		pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
+
 	return fd;
 }
 
@@ -194,7 +198,9 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user
 	if (magic2 == KSU_INSTALL_MAGIC2) {
 		int fd = ksu_install_fd();
 
-		pr_info("[%d] install ksu fd: %d\n", current->pid, fd);
+		if (IS_ENABLED(CONFIG_KSU_DEBUG))
+			pr_info("[%d] install ksu fd: %d\n", current->pid, fd);
+
 		if (copy_to_user((void __user *)arg4, &fd, sizeof(fd))) {
 			pr_err("install ksu fd reply err\n");
 			ksu_close_fd(fd);
-- 
2.43.0

