From: Justus <justadeayo@gmail.com>
Subject: [PATCH] kernel: build/qol: padronize the susfs messages

Signed-off-by: Justus <justadeayo@gmail.com>
---
 kernel/Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/kernel/Makefile b/kernel/Makefile
index 894d6127..3791c5ef 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -158,10 +158,10 @@ clean:
 ifeq ($(shell test -e $(srctree)/fs/susfs.c; echo $$?),0)
 $(eval SUSFS_VERSION=$(shell cat $(srctree)/include/linux/susfs.h | grep -E '^#define SUSFS_VERSION' | cut -d' ' -f3 | sed 's/"//g'))
 $(info )
-$(info -- SUSFS_VERSION: $(SUSFS_VERSION))
+$(info -- KernelSU/SuSFS: Version $(SUSFS_VERSION)) found!
 else
-$(info -- You have not integrated susfs in your kernel yet.)
-$(info -- Read: https://gitlab.com/simonpunk/susfs4ksu)
+$(info -- KernelSU/SuSFS: You have not integrated susfs in your kernel yet.)
+$(info -- KernelSU/SuSFS: Read https://gitlab.com/simonpunk/susfs4ksu)
 endif
 
 # Keep a new line here!! Because someone may append config
-- 
2.43.0

